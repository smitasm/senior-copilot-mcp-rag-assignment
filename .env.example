# Copy to .env and adjust as needed for local (non-Docker) runs. None of
# this is required to get started - every value here has a working default
# baked into the code (see the grep-able os.getenv(...) calls throughout) -
# this file exists purely as discoverable documentation of what's
# configurable, and as a starting point if you want to point the GUI at a
# different Ollama model/host, a non-default port, etc.
#
# docker-compose.yml sets its own values for ALARM_API_URL, TICKETING_API_URL
# and OLLAMA_URL (container-network hostnames, not localhost) - this file is
# for running the three processes directly on your own machine instead.

# --- Alarm API simulator (alarm_api/main.py) --------------------------------------
ALARM_API_PORT=8000
ALARM_API_TOKEN=demo-token
ALARM_API_SEED=42
ALARM_API_ENABLE_FAULTS=false        # set true to inject occasional 500s/timeouts for resilience testing

# --- Ticketing API mock (ticketing_api/main.py) ---------------------------------
TICKETING_API_PORT=8001
TICKETING_API_TOKEN=demo-token
TICKETING_API_SEED=42
TICKETING_API_ENABLE_FAULTS=false

# --- How the orchestrator's MCP clients and the GUI find the simulators above ----
ALARM_API_URL=http://localhost:8000
TICKETING_API_URL=http://localhost:8001

# --- Local LLM (Ollama) ------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text   # used by the RAG knowledge-base MCP server

# Ollama itself needs CONTEXT set above its 4096 default, or the 19 tool
# schemas plus conversation history overflow mid-investigation:
#   ollama run qwen2.5:3b
#   /set parameter num_ctx 16384
#   /save qwen2.5:3b
# (the orchestrator also sends num_ctx=16384 on every request as a
# belt-and-suspenders measure - see orchestrator/llm.py)
