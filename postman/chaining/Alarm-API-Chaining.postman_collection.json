  "item": [
    {
      "name": "CHAIN-01 Asset -> Summary -> Rationalization",
      "item": [
        {
          "name": "1) Search Boiler Feed Pump 101",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/assets/search?query=Boiler%20Feed%20Pump%20101&limit=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "pm.expect(body.results.length).to.be.above(0);",
                  "pm.collectionVariables.set('asset_id', body.results[0].asset_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2) Alarm Summary",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "trace_id", "value": "{{trace_id}}" },
              { "key": "x-client-id", "value": "{{x_client_id}}" },
              { "key": "x-metadata-tag", "value": "{{x_metadata_tag}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_ids\": [\"{{asset_id}}\"],\n  \"time_range\": {\n    \"start_time\": \"{{start_time}}\",\n    \"end_time\": \"{{end_time}}\"\n  },\n  \"severity\": [\"high\", \"critical\"],\n  \"group_by\": [\"alarm_name\"],\n  \"kpis\": [\"alarm_count\", \"recurring_rate\", \"avg_ack_delay\"]\n}"
            },
            "url": "{{baseUrl}}/alarms/summary"
          }
        },
        {
          "name": "3) Rationalization Candidates",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_ids\": [\"{{asset_id}}\"],\n  \"time_range\": {\n    \"start_time\": \"{{start_time}}\",\n    \"end_time\": \"{{end_time}}\"\n  },\n  \"recurrence_threshold\": 5\n}"
            },
            "url": "{{baseUrl}}/alarms/rationalization-candidates"
          }
        }
      ]
    },
    {
      "name": "CHAIN-02 Flood -> Alarms -> Summary",
      "item": [
        {
          "name": "1) Flood Analysis Unit 2",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unit\": \"Unit 2\",\n  \"time_range\": {\n    \"start_time\": \"{{start_time}}\",\n    \"end_time\": \"{{end_time}}\"\n  },\n  \"threshold_count\": 10,\n  \"rolling_window_minutes\": 10\n}"
            },
            "url": "{{baseUrl}}/alarms/flood-analysis"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "const ws = body.flood_windows || [];",
                  "if (ws.length > 0) {",
                  "  pm.collectionVariables.set('window_start', ws[0].start);",
                  "  pm.collectionVariables.set('window_end', ws[0].end);",
                  "} else {",
                  "  pm.collectionVariables.set('window_start', pm.collectionVariables.get('start_time'));",
                  "  pm.collectionVariables.set('window_end', pm.collectionVariables.get('end_time'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2) Get Alarms for Window",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/alarms?unit=Unit%202&start_time={{window_start}}&end_time={{window_end}}&page=1&page_size=200"
          }
        },
        {
          "name": "3) Summary by Asset+Severity",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unit\": \"Unit 2\",\n  \"time_range\": {\n    \"start_time\": \"{{start_time}}\",\n    \"end_time\": \"{{end_time}}\"\n  },\n  \"group_by\": [\"asset_id\", \"asset_name\", \"severity\"],\n  \"kpis\": [\"alarm_count\"]\n}"
            },
            "url": "{{baseUrl}}/alarms/summary"
          }
        }
      ]
    },
