                  "pm.collectionVariables.set('asset_id', r[0].asset_id);",
                  "pm.collectionVariables.set('asset_id_2', (r[1] || r[0]).asset_id);",
                  "pm.collectionVariables.set('asset_id_3', (r[2] || r[0]).asset_id);"
                ]
              }
