    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b51775c5-a9d9-4a98-8ec3-b2da3742f1f1"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "auth_token", "value": "demo-token" },
    { "key": "trace_id", "value": "trace-chain-001" },
    { "key": "x_client_id", "value": "postman-chain" },
    { "key": "x_metadata_tag", "value": "chain-test" },
    { "key": "start_time", "value": "2026-05-01T00:00:00Z" },
    { "key": "end_time", "value": "2026-07-01T00:00:00Z" },
    { "key": "asset_id", "value": "" },
    { "key": "asset_id_2", "value": "" },
    { "key": "asset_id_3", "value": "" },
    { "key": "alarm_id", "value": "" },
    { "key": "calculation_id", "value": "" },
    { "key": "window_start", "value": "{{start_time}}" },
    { "key": "window_end", "value": "{{end_time}}" }
