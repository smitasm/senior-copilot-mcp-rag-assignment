          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const rows = pm.response.json().data || [];",
                  "if (rows.length > 0) pm.collectionVariables.set('alarm_id', rows[0].alarm_id);"
                ]
              }
            }
